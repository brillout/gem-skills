{
  "name": "gemskills",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vike dev --root site --port 3000",
    "build": "vike build --root site",
    "preview": "vike preview --root site --port 3000",
    "========= Checks": "",
    "check": "pnpm run check:data && pnpm run check:types",
    "check:data": "pnpm run node-ts check.ts",
    "check:types": "tsc --noEmit",
    "========= SKILL.md copies": "",
    "sync": "pnpm run node-ts sync.ts",
    "tldr": "pnpm run node-ts tldr.ts",
    "========= Formatting": "",
    "format": "oxfmt",
    "===== Utils": "",
    "// Run a .ts file with Node.js <=23 — these two flags aren't needed anymore on Node.js 24+": "",
    "node-ts": "node --experimental-strip-types --no-warnings=ExperimentalWarning",
    "========= Only allow pnpm; forbid yarn & npm": "",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "diff": "^9.0.0",
    "markdown-it": "^15.0.3",
    "oxfmt": "^0.74.0",
    "typescript": "^7.0.2",
    "vike": "^0.4.268",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@10.33.0"
}
